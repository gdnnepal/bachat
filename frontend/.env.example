# Vite dev-server proxy target — the host Laragon serves PHP from.
VITE_API_TARGET=http://localhost

# Production API URL used by the deployed frontend.
VITE_API_BASE_PATH=https://bachatapi.gdn.com.np/api/v1

# Base URL the Axios client calls in production.
VITE_API_BASE_URL=https://bachatapi.gdn.com.np/api/v1
