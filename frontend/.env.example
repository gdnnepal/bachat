# Vite dev-server proxy target — the host Laragon serves PHP from.
VITE_API_TARGET=http://localhost

# Path the proxy rewrites /api/v1 to on that host.
VITE_API_BASE_PATH=/Bachat/backend/public/api/v1

# Base URL the Axios client calls. Leave as /api/v1 in development so the
# Vite proxy handles it; set to the full API URL for a production build.
VITE_API_BASE_URL=/api/v1
